# === Aurum Ghana Backend - Example Configuration ===
# Copy this file to .env and fill in your real values.
# DO NOT commit .env to version control.

# Environment
FLASK_ENV=production
FLASK_DEBUG=0

# Security - generate new random keys for production:
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://aurum:CHANGE_ME@localhost:5432/aurum_ghana
SQLALCHEMY_TRACK_MODIFICATIONS=False

# CORS (frontend origin) - update with your real domain
# Common dev ports: 8000 (Flask/Node), 5500 (Live Server), 8080 (http-server)
# For production: set to your actual frontend domain (e.g. https://aurum-ghana.com)
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Paystack - get keys from https://paystack.com -> Settings -> API Keys
# Test mode: sk_test_* / pk_test_*  (use for testing)
# Live mode: sk_live_* / pk_live_*  (use for real payments)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=http://localhost:8000/payment-callback.html
PAYSTACK_WEBHOOK_SECRET=

# Email (SMTP) - required for password reset, order confirmations
# Gmail: use an App Password from your Google account security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@aurum-ghana.local

# Rate limiting
RATE_LIMIT_AUTH=5 per 15 minutes

# Logging
LOG_LEVEL=INFO
